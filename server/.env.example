# REQUIRED for `npm start` (not for `npm run demo`, which makes one). 32+ random characters; the server refuses anything shorter or a placeholder.
# Generate on any OS: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Copy this file to server/.env (it is loaded automatically). Empty values are ignored.
JWT_SECRET=
# Optional but recommended: separate 32+ char key that encrypts the marketplace keys artisans save in the app (Profile > Marketplace keys).
# If empty, JWT_SECRET is used, and changing JWT_SECRET would make saved keys unreadable. Keep this value private and stable.
CRED_KEY=
# Postgres connection string (Neon/Supabase/Render). Empty = in-memory demo store (data is lost on restart). TLS certificates are verified.
DATABASE_URL=
# DATABASE_SSL=off        # only for a local Postgres without TLS
# DATABASE_CA=            # PEM of a private CA, if your database uses one
# Public URL of this API (marketplaces fetch listing photos from {PUBLIC_BASE_URL}/media/<id>)
PUBLIC_BASE_URL=
# Number of reverse proxies in front of the API (Render = 1). Wrong values break per-IP rate limiting.
TRUST_PROXY_HOPS=1

# ---- No third-party keys are needed. These switches control the built-in mocks ----
# Mock payments + mock Rs 1 bank verification. Default ON. The server REFUSES to start with NODE_ENV=production while mocks are on,
# unless you set ALLOW_MOCK_IN_PRODUCTION=1 (demo deployments only; no real money moves).
MOCK_PAYMENTS=1
# ALLOW_MOCK_IN_PRODUCTION=1
# Fake Amazon/Flipkart: listings go "live" and /dev/market-sale (dev only) can add fake sales. Used only when real credentials below are empty.
MOCK_MARKETPLACE=1
# Built-in price scraper reads public Amazon.in / Flipkart search pages. PRICE_SCRAPE=off uses typical per-craft ranges only.
# PRICE_SCRAPE=off

# ---- Optional: real marketplace credentials (never run against live marketplaces by us; see DEPLOY.md) ----
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_SELLER_ID=
AMAZON_PRODUCT_TYPE=PRODUCT
AMAZON_LIVE=
FLIPKART_APP_ID=
FLIPKART_APP_SECRET=
FLIPKART_LISTING_URL=
FLIPKART_ORDERS_URL=

# ---- Kautilya demo + AI features (all optional; everything works offline with the built-ins) ----
# One-tap "Try demo" login on the sign-in screen + seeded artisans/products/earnings. Ignored in production unless ALLOW_MOCK_IN_PRODUCTION=1.
DEMO_MODE=1
# Fair-wage labour rate (INR/hour) used by the pricing assistant's cost floor.
# LABOUR_RATE=100
# ---- Local AI models (no keys, no AI service calls). Download once with `npm run models` (see DEPLOY.md); each falls back to a built-in if missing ----
# LOCAL_MODELS=off                           # ignore downloaded models entirely
# MODELS_DIR=./models                        # where the weights live
# BG_MODEL=u2netp.onnx                       # background removal (U2-Net, ~5 MB). u2net.onnx is sharper but ~170 MB
# WHISPER_MODEL=Xenova/whisper-small         # speech-to-text + translation (~250 MB). whisper-base is lighter, whisper-medium is better
# LLM_MODEL=onnx-community/Qwen2.5-1.5B-Instruct   # listing writer (~1.1 GB, needs ~2 GB RAM). Qwen2.5-0.5B-Instruct is faster but weaker
# LLM_TIMEOUT_MS=60000                       # past this the built-in template writer answers instead
# FFMPEG_PATH=                               # only if ffmpeg-static is not installed and ffmpeg is not on PATH
# GeM / ONDC are demo-mode channels (fake listings + fake bulk orders). Real integrations are not implemented; see DEMO.md.
